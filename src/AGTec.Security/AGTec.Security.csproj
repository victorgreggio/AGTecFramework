<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework / Nullable / ImplicitUsings come from Directory.Build.props -->
    <IsPackable>true</IsPackable>
    <Description>AGTecFramework security: OIDC/JWT bearer authentication (single- and multi-tenant) and OAuth scope-based authorization.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Multi-tenant OIDC: validate tokens per tenant and read each tenant's discovery document. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
  </ItemGroup>
</Project>
