<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework / Nullable / ImplicitUsings come from Directory.Build.props -->
    <IsPackable>true</IsPackable>
    <Description>AGTecFramework feature flags on Microsoft.FeatureManagement: config-driven flags with the built-in filters (Percentage, TimeWindow, Targeting) and a tenant-aware targeting accessor so rollouts target per tenant. Azure App Configuration plugs in behind the same configuration (AGTec.FeatureManagement.Azure).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AGTec.Tenancy\AGTec.Tenancy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
  </ItemGroup>
</Project>
