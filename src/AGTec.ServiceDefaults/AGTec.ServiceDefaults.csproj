<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework / Nullable / ImplicitUsings come from Directory.Build.props -->
    <IsPackable>true</IsPackable>
    <Description>AGTecFramework service defaults: OpenTelemetry, health checks, service discovery, and HTTP resilience for API, Worker, and gRPC hosts.</Description>
  </PropertyGroup>

  <!-- ASP.NET Core types (health-check endpoints, routing) without a full web SDK. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <!-- Azure Monitor / Application Insights exporters (traces, metrics, logs), activated by config. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>
</Project>
