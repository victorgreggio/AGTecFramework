<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework / Nullable / ImplicitUsings come from Directory.Build.props -->
    <IsPackable>true</IsPackable>
    <Description>AGTecFramework Azure App Configuration adapter for feature flags: adds App Configuration as a configuration source with feature flags and dynamic refresh, so AGTec.FeatureManagement serves cloud-managed flags that flip at runtime without redeploy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AGTec.FeatureManagement\AGTec.FeatureManagement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
</Project>
