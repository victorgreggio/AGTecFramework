<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework / Nullable / ImplicitUsings come from Directory.Build.props -->
    <IsPackable>true</IsPackable>
    <Description>AGTecFramework AI building blocks on Microsoft.Extensions.AI: a no-model deterministic embedding generator (local default) and registration conventions. Cloud providers (OpenAI, Azure) plug in behind the standard abstractions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- Chat-client OpenTelemetry (OpenTelemetryChatClient + AsBuilder) lives in the full package. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
