<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>20415ff7-635c-4e99-bf83-0ba50f1b1255</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Elasticsearch" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <!-- Security override: pin MessagePack above the version the Dapr hosting package pulls (NU1902). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AGTec.Reference.Api\AGTec.Reference.Api.csproj" />
    <ProjectReference Include="..\AGTec.Reference.Worker\AGTec.Reference.Worker.csproj" />
    <ProjectReference Include="..\AGTec.Reference.Advisory\AGTec.Reference.Advisory.csproj" />
  </ItemGroup>
</Project>
